      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-18",
      "x": 60,
      "y": 405,
      "width": 230,
      "height": 32,
      "text": "- recompute leaf hash",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-19",
      "x": 60,
      "y": 437,
      "width": 230,
      "height": 32,
      "text": "- fold proof -> root",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-20",
      "x": 60,
      "y": 469,
      "width": 230,
      "height": 32,
      "text": "- check root == signed root",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-21",
      "x": 60,
      "y": 501,
      "width": 230,
      "height": 32,
      "text": "- Ed25519 verify(root, pubkey)",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "outcome-22",
      "x": 330,
      "y": 365,
      "width": 300,
      "height": 175,
      "strokeColor": "#0c8599",
