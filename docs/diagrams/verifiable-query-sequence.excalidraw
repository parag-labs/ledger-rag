    },
    {
      "type": "text",
      "id": "text-23",
      "x": 344,
      "y": 373,
      "width": 280,
      "height": 35,
      "text": "6. accept or reject",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-24",
      "x": 350,
      "y": 405,
      "width": 280,
      "height": 32,
      "text": "all checks pass -> trust the answer",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-25",
      "x": 350,
      "y": 437,
      "width": 280,
      "height": 32,
      "text": "any check fails -> reject",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-26",
      "x": 350,
      "y": 469,
      "width": 280,
      "height": 32,
      "text": "(no server access needed to verify)",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-27",
      "x": 40,
      "y": 585,
      "width": 820,
      "height": 35,
      "text": "The proof travels WITH the answer, so verification is independent -",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-28",
      "x": 40,
      "y": 617,
      "width": 820,
      "height": 35,
      "text": "a third party holding only the public key can check it.",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    }
  ],
